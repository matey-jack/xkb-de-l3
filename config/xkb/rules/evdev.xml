<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xkbConfigRegistry SYSTEM "xkb.dtd">
<!--
  Registration file for GNOME's UI.  It is read by libxkbregistry, which merges
  ~/.config/xkb/rules/evdev.xml with /etc/xkb/ and /usr/share/X11/xkb/ instead of
  replacing them, so only the additions belong here.  Nothing in this file
  affects how a keymap compiles; it only decides what the Settings dialog and the
  Super+Space switcher offer and what they call it.

  Check what the registry actually sees with:   ./test.sh
  A newly added name shows up in the UI after the next login.
-->
<xkbConfigRegistry version="1.1">

  <!--
    'prog' is registered as a variant of the stock 'de' layout, not as a layout
    of its own.  libxkbregistry merges variant lists, so de keeps all 20 of its
    upstream variants and gains this one; shortDescription, countryList and
    languageList are inherited from the stock de entry, which is why only name
    and description appear here (same shape as the upstream variants).
  -->
  <layoutList>
    <layout>
      <configItem>
        <name>de</name>
      </configItem>
      <variantList>
        <variant>
          <configItem>
            <name>prog</name>
            <description>Deutsch (Programmierung)</description>
          </configItem>
        </variant>
      </variantList>
    </layout>
  </layoutList>

  <!--
    Option groups merge the same way variant lists do, so this adds a 17th entry
    to the stock 'caps' group rather than creating a group of its own.  That is
    the point of putting it here: the group is allowMultipleSelection="false",
    so the UI now renders our option as one radio button among caps:none,
    caps:escape and the rest, which is honest: every one of them rebinds the
    Caps Lock key, so they were always mutually exclusive in fact.

    The name is 'shift_modifier' and not the obvious 'shift' because caps:shift
    is already taken upstream: it means "Caps Lock acts as Shift *with locking*"
    and is a types rule (+caps(shift)).  caps:shift_modifier is the exact analog
    of the stock caps:ctrl_modifier, "Make Caps Lock an additional Ctrl".

    The description and the group name here are only inherited by the UI; the
    group's own description ("Caps Lock behavior") comes from the stock file.
  -->
  <optionList>
    <group allowMultipleSelection="false">
      <configItem>
        <name>caps</name>
      </configItem>
      <option>
        <configItem>
          <name>caps:shift_modifier</name>
          <description>Make Caps Lock an additional Shift; any two Shift keys toggle Caps Lock</description>
        </configItem>
      </option>
    </group>
  </optionList>

</xkbConfigRegistry>
