<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xkbConfigRegistry SYSTEM "xkb.dtd">
<!--
  Registration file for GNOME's UI.  It is read by libxkbregistry, which merges
  ~/.config/xkb/rules/evdev.xml with /etc/xkb/ and /usr/share/X11/xkb/ instead of
  replacing them, so only the additions belong here.  Nothing in this file
  affects how a keymap compiles; it only decides what the Settings dialog and the
  Super+Space switcher offer and what they call it.

  Check what the registry actually sees with:   ./test.sh
  A newly added name shows up in the UI after the next login.
-->
<xkbConfigRegistry version="1.1">

  <!--
    'prog' is registered as a variant of the stock 'de' layout, not as a layout
    of its own.  libxkbregistry merges variant lists, so de keeps all 20 of its
    upstream variants and gains this one; shortDescription, countryList and
    languageList are inherited from the stock de entry, which is why only name
    and description appear here (same shape as the upstream variants).
  -->
  <layoutList>
    <layout>
      <configItem>
        <name>de</name>
      </configItem>
      <variantList>
        <variant>
          <configItem>
            <name>prog</name>
            <description>Deutsch (Programmierung)</description>
          </configItem>
        </variant>
      </variantList>
    </layout>
  </layoutList>

  <optionList>
    <group allowMultipleSelection="true">
      <configItem>
        <name>custom</name>
        <description>Miscellaneous options</description>
      </configItem>
      <option>
        <configItem>
          <name>custom:caps_shift</name>
          <description>Caps Lock is a third Shift; two Shift keys toggle Caps Lock</description>
        </configItem>
      </option>
    </group>
  </optionList>

</xkbConfigRegistry>
